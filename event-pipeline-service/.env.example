# Copy this file to .env and fill in real values. Never commit .env itself.

# HubSpot Private App token (Settings -> Integrations -> Private Apps)
HUBSPOT_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Anthropic API key (console.anthropic.com), used for the company-ICP judge step
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# --- Enrichment providers (all optional; each waterfall tier auto-skips when
# its key is blank). Order is fixed in enrichment.py:
#   email  = LeadMagic -> Prospeo
#   mobile = Prospeo -> Forager -> LeadMagic
# Prospeo API key (pk_...), used for email + mobile lookups
PROSPEO_KEY=pk_xxxxxxxx
# LeadMagic API key (lm_live_...), email tier-1 + mobile tier-3
LEADMAGIC_KEY=lm_live_xxxxxxxx
# Forager API key + account id (mobile tier-2). The account id is part of every
# Forager API path -- find both in app.forager.ai -> API settings.
FORAGER_KEY=xxxxxxxx.xxxxxxxx
FORAGER_ACCOUNT_ID=1234
# Mobile lookups are the expensive tier (Prospeo ~10cr, Forager 15cr,
# LeadMagic 5cr per hit). Set false to enrich email only.
ENRICH_MOBILE=true

# Company REVENUE enrichment (brand-only, pod-gated). Waterfall order over these
# providers; each skips if its key is blank. StoreLeads is the most accurate for
# ecommerce brands (needs a paid StoreLeads API key). LeadMagic + Prospeo reuse
# the keys above.
STORELEADS_KEY=
REVENUE_ORDER=storeleads,leadmagic,prospeo
ENRICH_REVENUE=true

# Path to the Google service account JSON key file (on the server, not in git)
GOOGLE_SERVICE_ACCOUNT_JSON=/etc/levanta-event-pipeline/google_service_account.json

# The Google Sheet to read from -- either the full URL or just the ID
# (the long string in the sheet's URL between /d/ and /edit)
GOOGLE_SHEET_ID=xxxxxxxx

# Sheet/tab names inside that spreadsheet, matching the Levanta event import template
CONTACT_SHEET_NAME=Contact Import
COMPANY_SHEET_NAME=Company Import

# How often to check the sheet for new rows, in seconds
POLL_INTERVAL_SECONDS=300

# Set to true to test the full qualify->dedupe->enrich->round-robin flow
# against LIVE HubSpot reads without creating/updating/associating anything.
# Leave false (or unset) for the real, live-writing service.
DRY_RUN=true

# Tags applied to every contact this service pushes -- override per deployment if needed
LEAD_SOURCE_VALUE=Event/Tradeshow
# Drill-down is read per-row from the sheet's "Event Name" column instead of a fixed value
