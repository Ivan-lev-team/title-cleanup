# Copy this file to .env and fill in real values. Never commit .env itself.

# HubSpot Private App token (Settings -> Integrations -> Private Apps)
HUBSPOT_TOKEN=pat-na1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Anthropic API key (console.anthropic.com), used for the company-ICP judge step
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Prospeo API key, used to find missing emails/LinkedIn during enrichment
PROSPEO_KEY=pk_xxxxxxxx

# Path to the Google service account JSON key file (on the server, not in git)
GOOGLE_SERVICE_ACCOUNT_JSON=/etc/levanta-event-pipeline/google_service_account.json

# The Google Sheet to read from -- either the full URL or just the ID
# (the long string in the sheet's URL between /d/ and /edit)
GOOGLE_SHEET_ID=xxxxxxxx

# Sheet/tab names inside that spreadsheet, matching the Levanta event import template
CONTACT_SHEET_NAME=Contact Import
COMPANY_SHEET_NAME=Company Import

# How often to check the sheet for new rows, in seconds
POLL_INTERVAL_SECONDS=300

# Tags applied to every contact this service pushes -- override per deployment if needed
LEAD_SOURCE_VALUE=Event/Tradeshow
# Drill-down is read per-row from the sheet's "Event Name" column instead of a fixed value
